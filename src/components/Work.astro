---
import TimeLine from "./shared/TimeLine.astro";
import TimeLineItem from "./shared/TimeLineItem.astro";
import Section from "./shared/Section.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section title={t('work')} id="work" index={1}>
    <TimeLine>
        <TimeLineItem
            inline
            date={`${t('sep')} 2025 — ${t('present')}`}
            title={t('work_tragsatec')}
            sitename="Tragsatec"
            description={t('work_tragsatec_description')}
            tech={["Java", "Spring Boot", "Python", "Angular", "Docker", "Haystack", "Qdrant", "GIS"]}
        />
        <TimeLineItem
            inline
            date={`${t('sep')} 2019 — ${t('sep')} 2020`}
            title={t('work_fujitsu')}
            sitename="Fujitsu"
            description={t('work_fujitsu_description')}
            tech={["Angular", "React Native", "Git", "SCRUM"]}
        />
    </TimeLine>
</Section>
