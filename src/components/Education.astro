---
import TimeLine from "./shared/TimeLine.astro";
import TimeLineItem from "./shared/TimeLineItem.astro";
import Section from "./shared/Section.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Section title={t('education')} id="education" index={4}>
    <TimeLine>
        <TimeLineItem
            date={`2026 — ${t('present')}`}
            title={t('education_unir_title')}
            sitename={t('education_unir_sitename')}
        />
        <TimeLineItem
            date="2020 — 2025"
            title={t('education_huelva_title')}
            sitename={t('education_huelva_sitename')}
        />
        <TimeLineItem
            date="2022 — 2023"
            title={t('education_riga_title')}
            sitename={t('education_riga_sitename')}
        />
        <TimeLineItem
            date="2017 — 2019"
            title={t('education_sevilla_title')}
            sitename={t('education_sevilla_sitename')}
        />
    </TimeLine>
</Section>
