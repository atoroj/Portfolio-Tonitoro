---
import Section from "./shared/Section.astro";
import CardProject from "./shared/CardProject.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="projects" title={t('projects')} index={2}>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <CardProject
            kind={t('kind_thesis')}
            status={t('status_iberlef')}
            title="MiSonGyny"
            description={t('misongyny_description')}
            tech={["PyTorch", "Hugging Face", "LoRA"]}
            link="https://github.com/atoroj/Misogyny-Lyrics-Detection-LLMs"
        />
        <CardProject
            kind={t('kind_personal')}
            status="github"
            title="Rydr"
            description={t('rydr_description')}
            tech={["FastAPI", "SQLAlchemy", "Swift"]}
            link="https://github.com/atoroj/Rydr"
        />
        <CardProject
            kind={t('kind_personal')}
            status={t('in_progress')}
            title="RoadDamage AI"
            description={t('roaddamage_description')}
            tech={["PyTorch", "YOLO", "OpenCV"]}
        />
    </div>
</Section>
