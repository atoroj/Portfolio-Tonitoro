---
import { languages } from '../../i18n/ui';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const translatedPath = useTranslatedPath(currentLang);
const t = useTranslations(currentLang);
---

<nav aria-label={t('lang_label')} class="flex items-center font-mono text-[13px]">
  {Object.keys(languages).map((lang, i) => (
    <>
      {i > 0 && <span class="px-1 text-muted" aria-hidden="true">/</span>}
      <a
        href={translatedPath('/', lang)}
        hreflang={lang}
        aria-current={lang === currentLang ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-10 items-center uppercase transition-colors',
          lang === currentLang ? 'text-fg' : 'text-muted hover:text-accent',
        ]}
      >
        {lang}
      </a>
    </>
  ))}
</nav>

<script>
  // Keep the section you are reading when switching language.
  document.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((link) => {
    link.addEventListener('click', () => {
      if (location.hash) link.hash = location.hash;
    });
  });
</script>
