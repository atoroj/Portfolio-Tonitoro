---
interface Props {
  id: string;
  title: string;
  index: number;
}
const { id, title, index } = Astro.props;
---

<section id={id} class="pt-20 md:pt-28">
  <h2 class="mb-10 flex items-baseline gap-4 font-display text-[28px] font-bold sm:text-[32px]">
    <span class="font-mono text-base text-accent">{String(index).padStart(2, '0')}.</span>
    {title}
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </h2>
  <slot />
</section>
