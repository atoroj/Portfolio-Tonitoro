---
interface Props {
  title: string;
  kind: string;
  status: string;
  description: string;
  tech: string[];
  link?: string;
}
const { title, kind, status, description, tech, link } = Astro.props;
---

<article class="relative flex flex-col gap-3.5 rounded-[10px] border border-line bg-surface p-6 transition-colors hover:border-accent">
  <div class="flex items-center justify-between font-mono text-xs text-muted">
    <span>{kind}</span>
    <span class="text-accent">{status}</span>
  </div>
  <h3 class="font-display text-[22px] font-semibold">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 after:content-['']">
        {title} <span class="text-accent" aria-hidden="true">↗</span>
      </a>
    ) : title}
  </h3>
  <p class="flex-1 text-sm leading-relaxed text-pretty text-muted">{description}</p>
  <p class="font-mono text-xs text-accent">{tech.join(' · ')}</p>
</article>
