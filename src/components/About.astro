---
import Section from "./shared/Section.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="about" title={t("about")} index={5}>
    <div class="flex flex-col items-center gap-8 md:flex-row md:items-start">
        <img
            src="/images/atoropeque.png"
            alt="Antonio Toro Jaén"
            loading="lazy"
            class="w-48 shrink-0 rounded-[10px] object-cover md:w-56"
        />
        <p class="max-w-3xl text-[17px] leading-relaxed text-pretty text-muted">
            {t("about_text")}
        </p>
    </div>
</Section>
